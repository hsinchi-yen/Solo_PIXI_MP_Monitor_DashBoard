# Solo PIXI MP Monitor Dashboard — server settings
# Copy to .env in this directory (next to docker-compose.yml). docker compose reads it and
# passes the values to the containers. Every line is optional; the defaults are shown.

# ── Version / time zone ───────────────────────────────────────────────────────
APP_VERSION=3.0.0
# daily AI report batch and "today" use this zone
APP_TZ=Asia/Taipei

# ── Container names and host ports (change only to run a second copy on one host) ──
# containers: <prefix>-db, <prefix>-api, <prefix>-nginx
PIXI_PREFIX=pixi-test
# dashboard
PIXI_HTTP_PORT=8001
# PostgreSQL — the desktop Log Uploader connects here
PIXI_DB_PORT=5433

# ── Administrator account (DB Tweak, 帳號管理, every upload batch) ─────────────
# Uploader accounts are created on the 帳號管理 page. Changing these signs the
# administrator out of every browser.
TWEAK_USER=pixi
TWEAK_PASS=pixipass
SESSION_TTL_HOURS=8

# ── Local LLM (AI report, uploader chat) ──────────────────────────────────────
LLM_API_BASE=http://10.20.30.23:8000/v1
LLM_API_KEY=tn8227
LLM_MODEL=Qwen3.8-27B-UD-Q6_K_L
# thinking costs ~15x latency on the dense 27B model
LLM_ENABLE_THINKING=false
LLM_REPORT_MAX_TOKENS=1536

# ── Statistics and AI reports ─────────────────────────────────────────────────
# statistics view refresh; web uploads refresh at once
STATS_REFRESH_SEC=300
# AI report after each web upload + daily batch
REPORT_AUTO=true
REPORT_DAILY_AT=18:00

# ── API ───────────────────────────────────────────────────────────────────────
# PostgreSQL connections per uvicorn worker
DB_POOL_MAX=8
