# Solo PIXI MP Monitor Dashboard — Environment Variables
# Copy this file to .env and fill in values for your environment.
# The API server reads these at startup; Docker Compose passes them automatically.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the FastAPI backend.
# Default matches the docker-compose.yml postgres service (port 5433).
DATABASE_URL=postgresql://pixi:pixipass@localhost:5433/pixi_test

# ── DB Tweak credentials ──────────────────────────────────────────────────────
# Used to authenticate admin (DB Tweak) API endpoints.
# The frontend encodes these as base64(user:pass) in the X-Tweak-Token header.
TWEAK_USER=pixi
TWEAK_PASS=pixipass

# ── Local LLM (AI Report / Log Uploader assistant) ───────────────────────────
# OpenAI-compatible llama.cpp server. Thinking is off by default: on the dense
# 27B model it costs ~15x latency (measured 20.7 s vs 1.1 s per short request).
LLM_API_BASE=http://10.20.30.23:8000/v1
LLM_API_KEY=tn8227
LLM_MODEL=Qwen3.8-27B-UD-Q6_K_L
LLM_ENABLE_THINKING=false
LLM_REPORT_MAX_TOKENS=1536

# ── Log uploader (web, Management → Log Uploader) ────────────────────────────
# Temporary storage for uploaded zips between analyze and commit (1 h TTL).
UPLOAD_TMP_DIR=/tmp/pixi_uploads

# ── Log uploader (desktop app) ────────────────────────────────────────────────
# Path where the log uploader stores split log files before uploading.
STORAGE_PATH=.
