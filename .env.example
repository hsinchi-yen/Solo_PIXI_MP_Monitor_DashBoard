# Solo PIXI MP Monitor Dashboard — Environment Variables
# Copy this file to .env and fill in values for your environment.
# The API server reads these at startup; Docker Compose passes them automatically.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the FastAPI backend.
# Default matches the docker-compose.yml postgres service (port 5433).
DATABASE_URL=postgresql://pixi:pixipass@localhost:5433/pixi_test

# ── DB Tweak credentials ──────────────────────────────────────────────────────
# Used to authenticate admin (DB Tweak) API endpoints.
# The frontend encodes these as base64(user:pass) in the X-Tweak-Token header.
TWEAK_USER=pixi
TWEAK_PASS=pixipass

# ── Log uploader (desktop app) ────────────────────────────────────────────────
# Path where the log uploader stores split log files before uploading.
STORAGE_PATH=.
